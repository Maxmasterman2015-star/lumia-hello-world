<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    IgnorableNamespaces="uap mp">

  <Identity
      Name="LumiaHelloWorld"
      ProcessorArchitecture="neutral"
      Publisher="CN=Lumia Dev"
      Version="1.0.0.0" />

  <mp:PhoneIdentity
      PhoneProductId="2DB559CF-2846-40EF-A817-4D6E7D853754"
      PhoneRevision="1" />

  <Properties>
    <DisplayName>Lumia Hello World</DisplayName>
    <PublisherDisplayName>Lumia Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Universal"
        MinVersion="10.0.10240.0"
        MaxVersionTested="10.0.15254.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
        Id="App"
        Executable="$targetnametoken$.exe"
        EntryPoint="LumiaHelloWorld.App">
      <uap:VisualElements
          DisplayName="Lumia Hello World"
          Description="A tiny demo app for the Lumia 950 XL (Windows 10 Mobile, 1709)."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          AppListEntry="All">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen
            Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
